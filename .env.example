# TaskFlow AI — Frontend environment
# Copy this file to `.env.local` only if you need to override defaults.

# Base URL of the TaskFlow API.
# Leave EMPTY during local development: Vite proxies `/api` to the backend,
# which avoids CORS allowlist issues on custom ports.
# In production set the absolute URL, e.g.:
# VITE_API_URL=https://ai-task-manager-backend-production-4622.up.railway.app/api
VITE_API_URL=

# Optional: override the proxy target used by `vite dev` / `vite preview`.
# VITE_API_PROXY_TARGET=http://localhost:5000
